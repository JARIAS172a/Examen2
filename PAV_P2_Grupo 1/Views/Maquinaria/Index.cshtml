@model List<PAV_P2_Grupo_1.Models.Maquinarias>
@{
    ViewData["Title"] = "Listado de Maquinaria";
}
<div class="container mt-4">
    <h2>Maquinaria de la Finca</h2>
    <div class="text-end mb-3">
        <a asp-action="Crear" class="btn btn-success">+ Nueva Maquinaria</a>
    </div>
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Creado por</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Marca</td>
                    <td>@item.Modelo</td>
                    <td>@item.UsuarioCreador?.Nombre</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar esta maquinaria?');">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
