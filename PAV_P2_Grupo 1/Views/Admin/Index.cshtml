@model IEnumerable<PAV_P2_Grupo_1.Models.ApplicationUser>

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li class="breadcrumb-item active">Usuarios</li>
</ol>


<div class="row">
    <div class="col-sm-3">
        <button type="button" class="btn btn-primary" onclick="location.href='/Identity/Account/Register'" ">
            <i class="fas fa-plus-circle"></i> Crear Nuevo Usuario
        </button>
    </div>
</div>


<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-table me-1"></i>
        Lista de usuarios
    </div>
    <div class="card-body">

        <hr />
        <table id="datatablesSimple">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th>Email</th>
                    <th>Dirección</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var user in Model)
        {
                    <tr>
                        <td>@user.Nombre</td>
                        <td>@user.Apellidos</td>
                        <td>@user.Email</td>
                        <td>@user.Direccion</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = user.Id })">Editar</a>@*  |
                        <a href="@Url.Action("Delete", new { id = user.Id })">Eliminar</a> *@
                        </td>
                    </tr>
        }
            </tbody>
        </table>

    </div>
</div>

        @section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="~/js/datatables-simple-demo.js"></script>
        }