@model List<PAV_P2_Grupo_1.Models.Productos>

@{
    ViewData["Title"] = "Listado de Productos";
}

<div class="container mt-4">

    @if (ViewBag.Top3 != null)
    {
        <h3 class="mb-4">Top 3 Productos Destacados</h3>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
            @foreach (var producto in ViewBag.Top3 as List<PAV_P2_Grupo_1.Models.Productos>)
            {
                <div class="col">
                    <div class="card h-100 shadow">
                        @if (!string.IsNullOrEmpty(producto.ImagenRuta))
                        {
                            <img src="@producto.ImagenRuta" class="card-img-top" alt="@producto.Nombre" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-secondary text-white" style="height: 200px;">
                                Sin imagen
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@producto.Nombre</h5>
                            <p class="card-text">@producto.Descripcion</p>
                        </div>
                        <div class="card-footer">
                            <small class="text-muted">Precio: ₡@producto.Precio.ToString("N2")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }


    <h2 class="mb-4">Listado de Productos</h2>

    <div class="mb-3 text-end">
        <a asp-action="Crear" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> Nuevo Producto
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover shadow">
            <thead class="table-dark">
                <tr>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Creado por</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagenRuta))
                            {
                                <img src="@item.ImagenRuta" alt="Imagen" width="80" height="80" class="img-thumbnail" />
                            }
                            else
                            {
                                <span class="text-muted">Sin imagen</span>
                            }
                        </td>
                        <td>@item.Nombre</td>
                        <td>@item.Descripcion</td>
                        <td>₡@item.Precio.ToString("N2")</td>
                        <td>@item.UsuarioCreador?.Nombre @item.UsuarioCreador?.Apellidos</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro de eliminar este producto?');">
                                    <i class="fas fa-trash-alt"></i> Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
