@{
	ViewData["Title"] = "Página de Inicio";
}

<main class="container mt-4">	
	@if (User.IsInRole("Administrador"))
	{
        <div class="text-center mb-4">
            <h1 class="fw-bold text-success">Administración</h1>
        </div>
        <div class="row row-cols-1 row-cols-md-5 g-3 justify-content-center">
            <div class="col-xl-3 col-md-6">
                <div class="card text-white bg-primary shadow-lg border-0 h-100 text-center">
                    <div class="card-body d-flex flex-column">
                        <i class="fas fa-users fa-3x mb-3"></i>
                        <h5 class="card-title fw-bold">Usuarios</h5>
                        <p class="card-text flex-grow-1">Gestiona los usuarios de la página.</p>
                    </div>
                    <div class="card-footer">
                        <a href="@Url.Action("Index", "Admin")" class="btn btn-light text-primary fw-bold mt-auto">
                            <i class="fas fa-arrow-right"></i> Ir a Usuarios
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card text-white bg-warning shadow-lg border-0 h-100 text-center">
                    <div class="card-body d-flex flex-column">
                        <i class="fas fa-box-open fa-3x mb-3"></i>
                        <h5 class="card-title fw-bold">Inventario</h5>
                        <p class="card-text flex-grow-1">Gestiona el catálogo de productos.</p>
                    </div>
                    <div class="card-footer">
                        <a href="@Url.Action("Index", "Inventario")" class="btn btn-light text-warning fw-bold mt-auto">
                            <i class="fas fa-arrow-right"></i> Ir a Inventario
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card text-white bg-success shadow-lg border-0 h-100 text-center">
                    <div class="card-body d-flex flex-column">
                        <i class="fas fa-tractor fa-3x mb-3"></i>
                        <h5 class="card-title fw-bold">Maquinaria</h5>
                        <p class="card-text flex-grow-1">Gestiona la maquinaria de la finca.</p>
                    </div>
                    <div class="card-footer">
                        <a href="@Url.Action("Index", "Maquinaria")" class="btn btn-light text-success fw-bold mt-auto">
                            <i class="fas fa-arrow-right"></i> Ir a Maquinaria
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card text-white bg-danger shadow-lg border-0 h-100 text-center">
                    <div class="card-body d-flex flex-column">
                        <i class="fas fa-comment fa-3x mb-3"></i>
                        <h5 class="card-title fw-bold">Preguntas</h5>
                        <p class="card-text flex-grow-1">Gestiona el feedback de los clientes.</p>

                    </div>
                    <div class="card-footer">
                        <a href="@Url.Action("Index", "Clientes")" class="btn btn-light text-danger fw-bold mt-auto">
                            <i class="fas fa-arrow-right"></i> Ir a Preguntas
                        </a>
                    </div>
                </div>
            </div>
        </div>
	}
	else
	{
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display&display=swap" rel="stylesheet">

        <style>
            .hero {
                background-image: url('/images/fondo-finca.jpg');
                background-size: cover;
                background-position: center;
                height: 75vh;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                color: white;
                position: relative;
            }

            .hero::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
            }

            .hero-content {
                position: relative;
                z-index: 1;
                font-family: 'Playfair Display', serif;
            }

            .hero-content h1 {
                font-size: 4rem;
                font-weight: bold;
            }

            .hero-content p {
                font-size: 1.25rem;
            }

            .section {
                padding: 4rem 2rem;
                font-family: 'Playfair Display', serif;
                text-align: center;
                background-color: #f8f9f3;
            }

            .section h2 {
                font-size: 2.5rem;
                color: #355e3b;
                margin-bottom: 1rem;
            }

            .section p {
                max-width: 800px;
                margin: 0 auto;
                font-size: 1.1rem;
                color: #333;
            }

            .card-container {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 2rem;
                margin-top: 3rem;
            }

            .info-card {
                background-color: white;
                border-radius: 1rem;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
                padding: 2rem;
                flex: 1 1 250px;
                max-width: 300px;
                transition: transform 0.3s ease;
            }

            .info-card:hover {
                transform: translateY(-5px);
            }

            .info-card h4 {
                color: #52734d;
                margin-bottom: 0.5rem;
            }

            .info-card a {
                display: inline-block;
                margin-top: 1rem;
                color: #6b8e23;
                text-decoration: none;
                font-weight: bold;
            }

            .info-card a:hover {
                text-decoration: underline;
            }
        </style>

        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-content">
                <h1>Bienvenido a Finca Agricola</h1>
                <p>Donde la naturaleza, el trabajo y la pasión se encuentran</p>
            </div>
        </section>

        <!-- Sobre Nosotros -->
        <section class="section">
            <h2>Sobre Nuestra Finca</h2>
            <p>
                En Finca Agricola combinamos tradición y tecnología para ofrecer productos sostenibles y de calidad.
                Nuestro compromiso con la tierra y la comunidad nos impulsa a cultivar con amor y responsabilidad.
            </p>

            <div class="card-container">
                <div class="info-card">
                    <h4>Nuestra Historia</h4>
                    <p>Descubre los orígenes, desafíos y evolución de la finca.</p>
                    <a asp-controller="Home" asp-action="Historia">Leer más →</a>
                </div>

                <div class="info-card">
                    <h4>Equipo Utilizado</h4>
                    <p>Conoce la maquinaria y herramientas que usamos para cultivar.</p>
                    <a asp-controller="Home" asp-action="Equipo">Ver equipo →</a>
                </div>

                <div class="info-card">
                    <h4>Contáctanos</h4>
                    <p>¿Tienes dudas o quieres visitarnos? Estamos para ayudarte.</p>
                    <a asp-controller="Home" asp-action="Contacto">Ir al contacto →</a>
                </div>
            </div>
        </section>
	}
	
</main>

