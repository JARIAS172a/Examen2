
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Dashboard</h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
        <div class="row">
            <div class="col-xl-3 col-md-6">
                <div class="card bg-primary text-white mb-4">
                    <div class="card-body">Usuarios</div>
                    <div class="card-footer d-flex align-items-center justify-content-between">
                        <a class="small text-white stretched-link" asp-area="" asp-controller="Admin" asp-action="Index">Ver Detalles</a>
                        <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-warning text-white mb-4">
                    <div class="card-body">Inventario</div>
                    <div class="card-footer d-flex align-items-center justify-content-between">
                        <a class="small text-white stretched-link" asp-area="" asp-controller="Home" asp-action="Index">Ver Detalles</a>
                        <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-success text-white mb-4">
                    <div class="card-body">Maquinaria</div>
                    <div class="card-footer d-flex align-items-center justify-content-between">
                        <a class="small text-white stretched-link" asp-area="" asp-controller="Home" asp-action="Index">Ver Detalles</a>
                        <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card bg-danger text-white mb-4">
                    <div class="card-body">Preguntas</div>
                    <div class="card-footer d-flex align-items-center justify-content-between">
                        <a class="small text-white stretched-link" asp-area="" asp-controller="Preguntas" asp-action="Index">Ver Detalles</a>

                        <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-6">
                <div class="card mb-4" style="height: 263px;">
                    <div class="card-header">
                        <i class="fas fa-question-circle me-1"></i>
                        Últimas Preguntas
                    </div>
                    <div class="card-body">
                        <div id="preguntasCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @if (ViewBag.UltimasPreguntas != null)
                                {
                                    var preguntas = (List<PAV_P2_Grupo_1.Models.Preguntas>)ViewBag.UltimasPreguntas;
                                    for (int i = 0; i < preguntas.Count; i++)
                                    {
                                        var p = preguntas[i];
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <h5 class="text-primary">@p.Titulo</h5>
                                            <p>@p.Contenido</p>
                                            <p class="text-muted" style="font-size: small;">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="carousel-item active">
                                        <p>No hay preguntas disponibles.</p>
                                    </div>
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#preguntasCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Anterior</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#preguntasCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Siguiente</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-6">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-star me-2"></i>Productos Destacados</span>
                        <div>
                            <button class="btn btn-sm btn-outline-secondary me-1" id="btn-prev-producto">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" id="btn-next-producto">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="productos-carousel" class="overflow-hidden position-relative" style="height: 250px;">
                            <div class="d-flex transition-slide" style="width: max-content;">
                                @foreach (var producto in (List<PAV_P2_Grupo_1.Models.Productos>)ViewBag.TopProductos)
                                {
                                    <div class="me-3" style="min-width: 250px; max-width: 250px;">
                                        <div class="card h-100 shadow-sm">
                                            @if (!string.IsNullOrEmpty(producto.ImagenRuta))
                                            {
                                                <img src="@producto.ImagenRuta" class="card-img-top" style="height: 120px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 120px;">
                                                    <span class="text-muted">Sin imagen</span>
                                                </div>
                                            }
                                            <div class="card-body p-2">
                                                <h6 class="card-title mb-1">@producto.Nombre</h6>
                                                <p class="card-text text-muted" style="font-size: 0.85em;">@producto.Descripcion</p>
                                                <p class="fw-bold mb-0">₡@producto.Precio.ToString("N2")</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
       
    </div>
</main>

@section Scripts {    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js" crossorigin="anonymous"></script>
    <script src="~/assets/demo/chart-area-demo.js"></script>
    <script src="~/assets/demo/chart-bar-demo.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="~/js/datatables-simple-demo.js"></script>
    <script src="~/js/CarouselDashboard.js"></script>
}